---
// 命令演示：上方像素终端逐条输入真实命令，下方方块舞台抽象表现结果；右侧（移动端在下）是可点击的步骤列表。
// 步骤列表是服务端渲染的完整内容（命令、说明、复制），终端与舞台只是装饰，读屏跳过。
import { demos } from '../../data/demos';
import './demo.css';

interface Props {
  id: keyof typeof demos;
}
const demo = demos[Astro.props.id];
---

<div class="cdemo" data-demo={demo.id} data-steps={JSON.stringify(demo.steps.map((s) => ({ tab: s.tab, show: s.show, phase: s.phase, hold: s.hold, scene: s.scene, fields: s.fields })))}>
  <div class="screen" aria-hidden="true">
    <div class="bar pixel">
      <span class="dots"><i></i><i></i><i></i></span>
      <span>{demo.title}</span>
    </div>
    <div class="term">
      <div class="command-slot">
        <span class="command-reserve" data-reserve></span>
        <span class="line" data-command-line><b>$</b> <span data-typed></span><span class="cur"></span></span>
      </div>
      <span class="phase" data-phase hidden></span>
    </div>
    <div class="stage" data-stage></div>
    <div class="fields" data-fields></div>
  </div>

  <div class="side">
    <ol class="steps">
      {
        demo.steps.map((s, i) => (
          <li data-step={i}>
            <button class="tab pixel" type="button" data-go={i} aria-describedby={`${demo.id}-note-${i}`}>
              <span class="num">{String(i + 1).padStart(2, '0')}</span>
              {s.tab}
            </button>
            <div class="detail">
              <p id={`${demo.id}-note-${i}`}>{s.note}</p>
              {s.show && s.copy && <div class="cmd">
                <code id={`${demo.id}-cmd-${i}`} tabindex="0">{s.show}</code>
                <button
                  class="copy pixel"
                  type="button"
                  data-copy={s.copy}
                  data-copy-target={`${demo.id}-cmd-${i}`}
                  aria-label={`复制完整命令：${s.copy}`}
                >
                  <span data-copy-label>复制</span>
                </button>
              </div>}
            </div>
          </li>
        ))
      }
    </ol>
    {
      demo.steps.length > 1 && (
        <div class="ctrl">
          <button class="btn pixel" type="button" data-toggle>
            暂停
          </button>
          <button class="btn pixel" type="button" data-replay>
            重播
          </button>
        </div>
      )
    }
  </div>
</div>

<script>
  import { bindCopy } from '../../scripts/copy';
  import { Stage, scenes } from './engine';
  import type { Scene } from '../../data/demos';

  interface S {
    tab: string;
    show?: string;
    phase?: string;
    hold?: number;
    scene: Scene;
    fields: string[];
  }

  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  bindCopy();

  document.querySelectorAll<HTMLElement>('.cdemo').forEach((root) => {
    const steps: S[] = JSON.parse(root.dataset.steps!);
    const stage = new Stage(root.querySelector('[data-stage]')!);
    const typed = root.querySelector<HTMLElement>('[data-typed]')!;
    const commandLine = root.querySelector<HTMLElement>('[data-command-line]')!;
    const phase = root.querySelector<HTMLElement>('[data-phase]')!;
    const reserve = root.querySelector<HTMLElement>('[data-reserve]')!;
    const hasPhases = steps.some((step) => step.phase);
    // 为最长命令预留换行空间，打字和阶段切换时舞台不随终端高度跳动。
    reserve.textContent = '$ ' + steps.reduce((longest, step) => (step.show?.length ?? 0) > longest.length ? step.show! : longest, '') + ' ▌';
    const fields = root.querySelector<HTMLElement>('[data-fields]')!;
    const items = [...root.querySelectorAll<HTMLElement>('[data-step]')];
    const toggle = root.querySelector<HTMLButtonElement>('[data-toggle]');
    let current = -1;
    let playing = false;
    let started = false;
    let completed = -1;
    let shownCommand = '';
    let playVersion = 0;
    root.dataset.js = '';

    const mark = (i: number) => {
      current = i;
      items.forEach((li, k) => {
        li.toggleAttribute('data-active', k === i);
        li.toggleAttribute('data-done', k < i);
        li.querySelector('.tab')!.setAttribute('aria-current', k === i ? 'step' : 'false');
      });
    };

    const showFields = (s: S) => {
      fields.replaceChildren(
        ...s.fields.map((f) => {
          const e = document.createElement('span');
          e.className = 'pixel';
          e.textContent = f;
          return e;
        }),
      );
    };

    /** 顺序推进复用当前舞台；跳步时无动画还原先前状态。 */
    async function show(i: number, animate: boolean) {
      const canContinue = i > 0 && completed === i - 1;
      completed = -1;
      stage.token++;
      const run = stage.forRun(!animate);
      root.dataset.state = 'rendering';
      mark(i);
      if (!canContinue) {
        completed = -1;
        stage.root.dataset.instant = '';
        run.clear();
        run.instant = true;
        for (let k = 0; k < i; k++) {
          await scenes[steps[k].scene](run);
          run.checkpoint();
        }
        // 先提交还原后的样式，避免旧节点重新播放入场和位移动画。
        void stage.root.offsetWidth;
        run.checkpoint();
        delete stage.root.dataset.instant;
      }
      run.instant = !animate;
      const cmd = steps.slice(0, i + 1).reverse().find((step) => step.show)?.show ?? '';
      commandLine.hidden = !cmd;
      phase.hidden = !hasPhases;
      phase.textContent = steps[i].phase ?? steps[i].tab;
      showFields(steps[i]);
      if (animate && cmd && cmd !== shownCommand) {
        typed.textContent = '';
        for (let c = 0; c < cmd.length; c++) {
          run.checkpoint();
          typed.textContent = cmd.slice(0, c + 1);
          await run.wait(c < 5 ? 40 : 14);
        }
        await run.wait(250);
      } else typed.textContent = cmd;
      run.checkpoint();
      shownCommand = cmd;
      await scenes[steps[i].scene](run);
      run.checkpoint();
      completed = i;
      root.dataset.state = 'complete';
    }

    async function play(from = 0) {
      const version = ++playVersion;
      playing = true;
      if (toggle) toggle.textContent = '暂停';
      try {
        for (let i = from; i < steps.length; i++) {
          if (version !== playVersion) return;
          await show(i, !reduced);
          await stage.forRun(false).wait(steps[i].hold ?? 1500);
        }
      } catch {
        return; // 被暂停、跳步或重播打断
      }
      if (version !== playVersion) return;
      playing = false;
      if (toggle) toggle.textContent = '播放';
    }

    const stop = () => {
      playVersion++;
      playing = false;
      stage.token++;
      if (toggle) toggle.textContent = '播放';
    };

    root.querySelectorAll<HTMLButtonElement>('[data-go]').forEach((b) =>
      b.addEventListener('click', () => {
        started = true;
        stop();
        show(Number(b.dataset.go), !reduced).catch(() => {});
      }),
    );
    toggle?.addEventListener('click', () => {
      started = true;
      if (playing) stop();
      else play(current < 0 || completed === steps.length - 1 ? 0 : completed === current ? current + 1 : current);
    });
    root.querySelector('[data-replay]')?.addEventListener('click', () => {
      started = true;
      stop();
      shownCommand = '';
      play(0);
    });

    if (reduced) {
      show(steps.length - 1, false).catch(() => {});
      if (toggle) toggle.textContent = '播放';
      return;
    }
    // 进入视口播一轮后停在最后一步
    show(0, false).catch(() => {});
    if (toggle) toggle.textContent = '播放';
    const io = new IntersectionObserver(
      ([e]) => {
        if (e.isIntersecting && !started) {
          started = true;
          play(0);
        }
      },
      { threshold: 0.35 },
    );
    io.observe(root);
  });
</script>
