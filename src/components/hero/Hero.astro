---
// Hero：定位 + 安装命令框 + 开发↔游玩星球（3D 岛，失败时保留静态星球与徽章列表）
import InstallBox from '../InstallBox.astro';
import StaticPlanet from './StaticPlanet.astro';
import Planet from './Planet';
import { capabilities } from '../../data/capabilities';

const tags = ['Windows', 'Apple Silicon macOS', 'Android ARM64', 'MIT 开源'];
---

<section class="hero" aria-labelledby="hero-title">
  <!-- 3D 画布铺满整个 Hero（全宽），星球通过相机偏移对齐右侧舞台 -->
  <div class="hero-bg">
    <Planet client:only="react" capabilities={capabilities} />
  </div>
  <div class="hero-copy">
    <p class="eyebrow pixel">&gt;_ 我的世界中国版 · 命令行开发工具</p>
    <h1 id="hero-title" class="pixel">
      从<span class="dev">代码</span>到<span class="play">世界</span>，<br />只隔一条命令
    </h1>
    <p class="lead">
      用 Python 标准项目与依赖管理方式开发《我的世界》中国版 Mod 和资源包。依赖、构建、打包、进游戏测试都是一条命令，AI
      Agent 也能自己搭环境、跑游戏、操作和截图验收。
    </p>
    <div class="platform-switch" data-platform-switch role="tablist" aria-label="选择开发平台">
      <button class="platform-tab pixel" type="button" role="tab" aria-selected="true" data-platform-tab="desktop">桌面端</button>
      <button class="platform-tab pixel" type="button" role="tab" aria-selected="false" data-platform-tab="android">Android</button>
    </div>
    <div class="platform-panel" data-platform-panel="desktop">
      <InstallBox />
    </div>
    <div class="platform-panel android-panel" data-platform-panel="android" hidden>
      <a class="android-download pixel" href="https://github.com/EaseCation/mcpywrap-android/releases/download/nightly/mcpywrap-android-nightly-arm64.apk">
        <span>下载 Android 预览版</span><span aria-hidden="true">↗</span>
      </a>
      <p class="android-note">Nightly · Android 11+ · ARM64；首次使用需在 App 内安装游戏运行环境。</p>
    </div>
    <div class="links">
      <a class="btn primary pixel" href="#start"><span>快速开始</span></a>
      <a class="btn pixel" href="https://github.com/EaseCation/mcpywrap"><span>GitHub</span></a>
      <a class="btn pixel" href="/wiki/"><span>阅读 Wiki</span></a>
    </div>
    <ul class="tags" aria-label="支持平台与版本">
      {tags.map((t) => <li class="pixel"><span>{t}</span></li>)}
    </ul>
  </div>

  <div class="hero-stage">
    <div class="planet-wrap" data-planet-wrap>
      <StaticPlanet />
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-platform-switch]').forEach((switcher) => {
    const tabs = [...switcher.querySelectorAll<HTMLButtonElement>('[data-platform-tab]')];
    const root = switcher.closest('.hero');
    if (!root) return;
    const select = (platform: string) => {
      tabs.forEach((tab) => tab.setAttribute('aria-selected', String(tab.dataset.platformTab === platform)));
      root.querySelectorAll<HTMLElement>('[data-platform-panel]').forEach((panel) => {
        panel.hidden = panel.dataset.platformPanel !== platform;
      });
    };
    tabs.forEach((tab) => tab.addEventListener('click', () => select(tab.dataset.platformTab || 'desktop')));
    if (/Android/i.test(navigator.userAgent)) select('android');
  });
</script>

<style>
  .hero {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: clamp(24px, 4vw, 56px);
    align-items: center;
    max-width: 1320px;
    margin: 0 auto;
    padding: clamp(32px, 6vw, 72px) clamp(16px, 4vw, 48px) 48px;
    min-height: calc(100vh - 72px);
  }
  .hero-bg {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 100vw;
    transform: translateX(-50%);
    z-index: 0;
  }
  .hero-copy,
  .hero-stage {
    position: relative;
    z-index: 1;
  }
  /* 舞台只用来占位和对齐，事件交给下面的画布 */
  .hero-stage {
    pointer-events: none;
  }
  .eyebrow {
    margin: 0 0 16px;
    font-size: var(--px-12);
    color: var(--c-acid);
    letter-spacing: 1px;
  }
  h1 {
    margin: 0 0 20px;
    font-size: var(--px-48);
    line-height: 1.25;
    color: var(--c-prompt);
    font-weight: normal;
  }
  h1 .dev {
    color: var(--c-mint);
  }
  h1 .play {
    color: var(--c-warm);
  }
  .lead {
    margin: 0 0 28px;
    max-width: 34em;
    color: var(--c-text);
    font-size: 17px;
  }
  .platform-switch {
    display: inline-flex;
    margin: 0 0 10px;
    border: 1px solid var(--c-line);
    background: rgb(16 28 43 / .72);
  }
  .platform-tab {
    border: 0;
    border-right: 1px solid var(--c-line);
    padding: 7px 14px 5px;
    color: var(--c-text-dim);
    background: transparent;
    font-size: var(--px-12);
    cursor: pointer;
  }
  .platform-tab:last-child { border-right: 0; }
  .platform-tab[aria-selected='true'] { color: var(--c-void); background: var(--c-mint); }
  .platform-panel[hidden] { display: none; }
  .android-download {
    display: inline-flex;
    justify-content: space-between;
    gap: 36px;
    min-width: min(100%, 360px);
    padding: 14px 18px 12px;
    color: var(--c-void);
    background: var(--c-mint);
    box-shadow: var(--bevel);
    text-decoration: none;
    font-size: var(--px-12);
  }
  .android-download:hover { background: var(--c-acid); }
  .android-note { max-width: 520px; margin: 10px 0 0; color: var(--c-text-dim); font-size: 13px; }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin: 20px 0 24px;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 40px;
    font-size: var(--px-12);
    line-height: 1;
    padding: 10px 16px;
    color: var(--c-text);
    background: var(--c-bg-2);
    box-shadow: var(--bevel);
    text-decoration: none;
  }
  .btn:hover {
    color: var(--c-acid);
  }
  .btn.primary {
    background: var(--c-mint);
    color: var(--c-void);
    box-shadow:
      inset calc(var(--u) * -1) calc(var(--u) * -1) 0 0 rgb(0 0 0 / 0.25),
      inset var(--u) var(--u) 0 0 rgb(255 255 255 / 0.45);
  }
  .btn.primary:hover {
    background: var(--c-acid);
    color: var(--c-void);
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .tags li {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 28px;
    font-size: var(--px-12);
    line-height: 1;
    padding: 4px 8px;
    border: 2px solid var(--c-line);
    color: var(--c-text-dim);
  }
  /* 像素字体的字形视觉重心偏低，单独校正文字，边框与点击区域保持原位。 */
  .btn > span,
  .tags li > span {
    transform: translateY(-1px);
  }

  .hero-stage {
    display: flex;
    flex-direction: column;
    gap: 16px;
    min-width: 0;
  }
  .planet-wrap {
    position: relative;
    aspect-ratio: 1;
    width: 100%;
    max-height: 78vh;
    margin: 0 auto;
  }
  @media (max-width: 960px) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
      min-height: 0;
    }
    .hero-stage {
      order: -1;
    }
    .planet-wrap {
      max-width: 520px;
    }
    h1 {
      font-size: var(--px-36);
    }
  }
  @media (max-width: 480px) {
    h1 {
      font-size: var(--px-24);
      line-height: 1.5;
    }
  }
</style>
