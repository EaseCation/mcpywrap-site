---
// 首页布局：不经过 Starlight，自带导航与页脚
import '../styles/tokens.css';
import '../styles/home.css';
import BrandMark from '../assets/mcpy-mark.svg';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';

interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'mcpywrap · 我的世界中国版命令行开发工具',
  description = '用 Python 标准项目与依赖管理方式开发《我的世界》中国版 Mod 和资源包。',
} = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b141f" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/fusion-pixel-proportional.woff2" as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
    <GoogleAnalytics />
  </head>
  <body>
    <a class="skip" href="#main">跳到正文</a>
    <header class="nav">
      <div class="nav-left">
        <a class="brand pixel" href="/">
          <BrandMark aria-hidden="true" focusable="false" width="32" height="32" />
          <span>mcpywrap</span>
        </a>
        <nav class="section-nav" aria-label="首页快捷导航">
          <a class="pixel sec-link" href="/#ai">AI 闭环</a>
          <a class="pixel sec-link" href="/#deps">依赖</a>
          <a class="pixel sec-link" href="/#macos">macOS</a>
          <a class="pixel sec-link" href="/#scripts">脚本</a>
          <a class="pixel sec-link" href="/#server">服务器</a>
        </nav>
      </div>
      <nav class="resource-nav" aria-label="文档与源码">
        <a class="resource-link" href="/wiki/" aria-label="Wiki 文档" title="Wiki 文档">
          <svg aria-hidden="true" focusable="false" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 5.5C8.5 3.5 5.5 3.5 2 4v15c3.5-.5 6.5-.5 10 1.5 3.5-2 6.5-2 10-1.5V4c-3.5-.5-6.5-.5-10 1.5Z" />
            <path d="M12 5.5v15" />
          </svg>
          <span>Wiki</span>
        </a>
        <a class="resource-link" href="https://github.com/EaseCation/mcpywrap" aria-label="GitHub 源码" title="GitHub 源码">
          <svg aria-hidden="true" focusable="false" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.86c-2.78.6-3.37-1.18-3.37-1.18-.46-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.61.07-.61 1 .07 1.53 1.03 1.53 1.03.89 1.53 2.34 1.09 2.91.83.09-.65.35-1.09.64-1.34-2.22-.25-4.56-1.11-4.56-4.94 0-1.09.39-1.99 1.03-2.69-.1-.26-.45-1.28.1-2.66 0 0 .84-.27 2.75 1.03A9.6 9.6 0 0 1 12 6.81c.85 0 1.7.11 2.5.34 1.91-1.3 2.75-1.03 2.75-1.03.55 1.38.2 2.4.1 2.66.64.7 1.03 1.6 1.03 2.69 0 3.84-2.34 4.69-4.58 4.94.36.31.68.92.68 1.85v2.75c0 .27.18.58.69.48A10 10 0 0 0 12 2Z" />
          </svg>
          <span>GitHub</span>
        </a>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="foot">
      <p>
        mcpywrap 由 EaseCation 开源维护 · 中文像素字体
        <a href="https://github.com/TakWolf/fusion-pixel-font">Fusion Pixel</a>（<a href="/fonts/OFL.txt">SIL OFL 1.1</a>）
      </p>
    </footer>
  </body>
</html>
